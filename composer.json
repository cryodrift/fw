{
    "name": "cryodrift/fw",
    "description": "Small PHP framework for CLI, SSR, SQLite, and zero-logic templates",
    "type": "library",
    "license": "MIT",
    "version": "0.1.46",
    "require": {
        "php": ">=8.4",
        "ext-pdo": "*",
        "ext-fileinfo": "*",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-zlib": "*",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-openssl": "*",
        "ext-exif": "*",
        "ext-zip": "*",
        "ext-bcmath": "*",
        "ext-gd": "*",
        "ext-gmp": "*"
    },
    "autoload": {
        "psr-4": {
            "cryodrift\\fw\\": ""
        }
    },
    "bin": [
        "tool/cryodrift.php"
    ]
}
